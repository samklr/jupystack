# MinIO root credentials (S3 console + admin)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# S3A credentials used by every Spark component and Iceberg REST.
# For a single-user demo these are the same as the root credentials.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Spark worker sizing
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g

# Leave empty for token-less JupyterLab (demo only); set a value to require it.
JUPYTER_TOKEN=

# ---- Used only by scripts/k8s-spark-submit.sh (not by docker compose) ----
# K8S_API=https://my-cluster.example.com:6443
# SPARK_IMAGE=ghcr.io/my-org/spark:3.5.3
# K8S_NAMESPACE=default
# K8S_SA=spark
# S3_ENDPOINT=http://host.docker.internal:9000
